---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/bus-tracking.css';

const traccarUrl  = import.meta.env.PUBLIC_TRACCAR_URL  ?? '';
const apiToken    = import.meta.env.PUBLIC_TRACCAR_TOKEN ?? '';
const deviceId1   = Number(import.meta.env.PUBLIC_TRACCAR_DEVICE_ID_1 ?? 8);
const deviceId2   = Number(import.meta.env.PUBLIC_TRACCAR_DEVICE_ID_2 ?? 9);
---

<BaseLayout>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <main class="bus-tracking-page">

    <div class="bus-tracking-header">
      <a href="/#transport" class="back-link">← Naslovna</a>
    </div>

    <div class="bus-map-wrapper">
      <div id="bus-map"></div>
      <div id="tracking-pending" class="tracking-pending">
        <div class="tracking-pending-inner">
          <span class="tracking-pending-icon">🚌</span>
          <p class="tracking-pending-title">GPS praćenje počinje u 10:30</p>
          <p class="tracking-pending-sub">Autobusi kreću s ruta u 10:30. <br>Stranica će se automatski aktivirati.</p>
          <div class="tracking-pending-timer" id="tracking-pending-countdown">–:––</div>
        </div>
      </div>
    </div>

  </main>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://unpkg.com/leaflet-polylinedecorator@1.6.0/dist/leaflet.polylineDecorator.js"></script>

  <script is:inline define:vars={{ traccarUrl, apiToken, deviceId1, deviceId2 }}>
    const LINE1_COLOR = '#EAC31B';
    const LINE2_COLOR = '#4A9EE0';

    const IS_MOBILE     = window.innerWidth < 768;
    const ICON_SIZE     = IS_MOBILE ? 48 : 32;
    const ROUTE_WEIGHT  = IS_MOBILE ? 5  : 3;
    const ARROW_SIZE    = IS_MOBILE ? 13 : 9;

    console.log('[Traccar] config:', { traccarUrl, hasToken: !!apiToken, deviceId1, deviceId2 });

    // ── Stop data ──────────────────────────────────────────────────
    const line1Stops = [
      {
        name: 'Autobusna stanica Voltino',
        subtitle: 'TVZ ELO ODJEL',
        address: 'Konavoska ulica 2',
        lat: 45.800505, lng: 15.925867,
      },
      {
        name: 'Autobusna stanica Marohnićeva',
        subtitle: 'Dvorana Kornati — TVZ Career Day',
        address: 'Josipa Marohnića',
        lat: 45.794051, lng: 15.969763,
        isVenue: true,
      },
      {
        name: 'Autobusna stanica Marohnićeva (drugi smjer)',
        subtitle: 'Dvorana Kornati — TVZ Career Day',
        address: 'Josipa Marohnića',
        lat: 45.794340, lng: 15.967690,
        isVenue: true,
        tooltipDir: 'top',
      },
      {
        name: 'Autobusna stanica Građevinska škola',
        subtitle: 'TVZ GRO ODJEL',
        address: 'Avenija Večeslava Holjevca 15',
        lat: 45.771559, lng: 15.981728,
      },
    ];

    const line2Stops = [
      {
        name: 'Kampus Borongaj',
        subtitle: 'TVZ INRO ODJEL',
        address: 'Borongajska cesta 83E',
        lat: 45.806013, lng: 16.034933,
      },
      {
        name: 'Autobusna stanica Marohnićeva',
        subtitle: 'Dvorana Kornati — TVZ Career Day',
        address: 'Josipa Marohnića',
        lat: 45.794051, lng: 15.970013,
        isVenue: true,
        tooltipDir: 'bottom',
      },
    ];

    // ── Map init ───────────────────────────────────────────────────
    const map = L.map('bus-map', { zoomControl: true }).setView([45.794051, 15.969763], 15);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    // ── Layer groups (one per line, toggled by chip clicks) ────────
    const line1Group = L.layerGroup().addTo(map);
    const line2Group = L.layerGroup().addTo(map);

    // ── Bounds (for fitBounds) ─────────────────────────────────────
    const line1Coords = line1Stops.map(s => [s.lat, s.lng]);
    const line2Coords = [...line2Stops.map(s => [s.lat, s.lng]), [45.800505, 15.925867]]; // include shared Voltino
    const allCoords   = [...line1Coords, ...line2Stops.map(s => [s.lat, s.lng])];

    const line1Bounds = L.latLngBounds(line1Coords);
    const line2Bounds = L.latLngBounds(line2Coords);
    const allBounds   = L.latLngBounds(allCoords);

    function startIntroAnimation() {
      map.setView([45.794051, 15.969763], 15);
      setTimeout(() => map.flyToBounds(allBounds, { padding: [20, 20], duration: 3 }), 3000);
    }

    startIntroAnimation();
    window.addEventListener('pageshow', (e) => { if (e.persisted) startIntroAnimation(); });

    // ── GPX routes with directional arrows ─────────────────────────
    function arrowPattern(color) {
      return {
        offset: '8%',
        repeat: '18%',
        symbol: L.Symbol.arrowHead({
          pixelSize: ARROW_SIZE,
          headAngle: 55,
          pathOptions: { fill: true, fillOpacity: 0.9, weight: 0, color },
        }),
      };
    }

    async function loadGpxRoute(url, color, group) {
      try {
        const res  = await fetch(url);
        const text = await res.text();
        const xml  = new DOMParser().parseFromString(text, 'application/xml');
        const pts  = Array.from(xml.querySelectorAll('trkpt'));
        if (!pts.length) return;

        const coords = pts.map(p => [
          parseFloat(p.getAttribute('lat')),
          parseFloat(p.getAttribute('lon')),
        ]);

        const line = L.polyline(coords, {
          color,
          weight: ROUTE_WEIGHT,
          opacity: 0.85,
          dashArray: '10 7',
          lineJoin: 'round',
        });

        group.addLayer(line);
        group.addLayer(L.polylineDecorator(line, { patterns: [arrowPattern(color)] }));
      } catch (e) {
        console.warn('GPX load failed:', url, e);
      }
    }

    loadGpxRoute('/routes/voltino.gpx', LINE1_COLOR, line1Group);
    loadGpxRoute('/routes/borongaj.gpx', LINE2_COLOR, line2Group);

    // ── Stop marker icons ──────────────────────────────────────────
    function stopIcon(color) {
      const svgUrl = color === LINE1_COLOR ? '/pois/poi-yellow.svg' : '/pois/poi-blue.svg';
      return L.divIcon({
        html: `<img src="${svgUrl}" width="${ICON_SIZE}" height="${ICON_SIZE}" alt="" style="display:block;">`,
        className: '',
        iconSize: [ICON_SIZE, ICON_SIZE],
        iconAnchor: [ICON_SIZE / 2, ICON_SIZE],
      });
    }

    function busIcon(color) {
      const svgUrl = color === LINE2_COLOR ? '/pois/bus-blue.svg' : '/pois/bus-yellow.svg';
      return L.divIcon({
        html: `<img src="${svgUrl}" width="${ICON_SIZE}" height="${ICON_SIZE}" alt="" style="display:block;">`,
        className: '',
        iconSize: [ICON_SIZE, ICON_SIZE],
        iconAnchor: [ICON_SIZE / 2, ICON_SIZE / 2],
      });
    }

    // ── Stop markers (added to their layer group) ──────────────────
    function popupHtml(stop, color) {
      return `<div style="font-family:sans-serif;min-width:150px;padding:2px 0">
        <div style="font-size:10px;color:#888;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px">${stop.name}</div>
        <div style="font-weight:700;color:${color};font-size:13px;margin-bottom:2px">${stop.subtitle}</div>
        <div style="font-size:12px;color:#aaa">${stop.address}</div>
      </div>`;
    }

    const line1Markers = [];
    const line2Markers = [];

    const tooltipTimers = new WeakMap();

    function openTooltipTimed(marker) {
      if (tooltipTimers.has(marker)) clearTimeout(tooltipTimers.get(marker));
      marker.openTooltip();
      tooltipTimers.set(marker, setTimeout(() => marker.closeTooltip(), 3000));
    }

    function bindClickTooltip(marker, html, dir) {
      marker.bindTooltip(html, {
        permanent: false,
        direction: dir || 'top',
        className: 'bus-tooltip',
        offset: (dir === 'bottom') ? [0, 36] : [0, -36],
      });
      marker.off('mouseover').off('mouseout');
      marker.on('click', () => {
        marker.isTooltipOpen() ? marker.closeTooltip() : openTooltipTimed(marker);
      });
    }

    line1Stops.forEach(stop => {
      const marker = L.marker([stop.lat, stop.lng], { icon: stopIcon(LINE1_COLOR) });
      if (!stop.noTooltip) {
        bindClickTooltip(marker, popupHtml(stop, LINE1_COLOR), stop.tooltipDir);
        line1Markers.push(marker);
      }
      line1Group.addLayer(marker);
    });

    line2Stops.forEach(stop => {
      const marker = L.marker([stop.lat, stop.lng], { icon: stopIcon(LINE2_COLOR) });
      if (!stop.noTooltip) {
        bindClickTooltip(marker, popupHtml(stop, LINE2_COLOR), stop.tooltipDir);
        line2Markers.push(marker);
      }
      line2Group.addLayer(marker);
    });

    // ── Chip control — built as a Leaflet control so it sits on the map ──
    const ChipControl = L.Control.extend({
      onAdd() {
        const wrap = L.DomUtil.create('div', 'bus-chips-on-map');
        wrap.innerHTML = `
          <div class="bus-status-chip selected" id="chip-all">
            <span class="dot" style="background:#ccc;"></span>
            <span class="line-label">Sve rute</span>
          </div>
          <div class="bus-status-chip" id="chip-1">
            <span class="dot" style="background:${LINE1_COLOR};"></span>
            <span class="line-label">Linija 1</span>
            <span class="status-text" id="status-text-1">Učitavanje...</span>
          </div>
          <div class="bus-status-chip" id="chip-2">
            <span class="dot" style="background:${LINE2_COLOR};"></span>
            <span class="line-label">Linija 2</span>
            <span class="status-text" id="status-text-2">Učitavanje...</span>
          </div>
        `;
        L.DomEvent.disableClickPropagation(wrap);
        return wrap;
      },
    });
    new ChipControl({ position: 'topleft' }).addTo(map);

    // ── Fullscreen control ─────────────────────────────────────────
    const FullscreenControl = L.Control.extend({
      onAdd() {
        const btn = L.DomUtil.create('div', 'bus-fullscreen-btn');
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>';
        btn.title = 'Fullscreen';
        L.DomEvent.disableClickPropagation(btn);
        L.DomEvent.on(btn, 'click', () => {
          const el = document.getElementById('bus-map');
          if (!document.fullscreenElement) {
            el.requestFullscreen();
          } else {
            document.exitFullscreen();
          }
        });
        document.addEventListener('fullscreenchange', () => {
          const isFs = !!document.fullscreenElement;
          btn.innerHTML = isFs
            ? '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>'
            : '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>';
        });
        return btn;
      },
    });
    new FullscreenControl({ position: 'topright' }).addTo(map);

    // ── Chip filter (click to isolate a line) ──────────────────────
    const chipAll     = document.getElementById('chip-all');
    const chip1       = document.getElementById('chip-1');
    const chip2       = document.getElementById('chip-2');
    const statusText1 = document.getElementById('status-text-1');
    const statusText2 = document.getElementById('status-text-2');

    function closeAllTooltips() {
      [...line1Markers, ...line2Markers].forEach(m => m.closeTooltip());
    }

    function setFilter(lineNum) {
      chipAll.classList.toggle('selected', lineNum === null);
      chip1.classList.toggle('selected', lineNum === 1);
      chip2.classList.toggle('selected', lineNum === 2);

      closeAllTooltips();

      if (lineNum === null) {
        map.addLayer(line1Group);
        map.addLayer(line2Group);
        map.fitBounds(boundsWithUser(allBounds), { padding: [20, 20] });
      } else if (lineNum === 1) {
        map.addLayer(line1Group);
        map.removeLayer(line2Group);
        line1Markers.forEach(m => openTooltipTimed(m));
        map.fitBounds(boundsWithUser(line1Bounds), { padding: [20, 20] });
      } else {
        map.removeLayer(line1Group);
        map.addLayer(line2Group);
        line2Markers.forEach(m => openTooltipTimed(m));
        map.fitBounds(boundsWithUser(line2Bounds), { padding: [20, 20] });
      }
    }

    chipAll.addEventListener('click', () => setFilter(null));
    chip1.addEventListener('click',   () => setFilter(1));
    chip2.addEventListener('click',   () => setFilter(2));

    // ── Live bus tracking ──────────────────────────────────────────
    async function fetchPosition(deviceId) {
      const url = `${traccarUrl}/api/positions?deviceId=${deviceId}`;
      const res = await fetch(url, { headers: { Authorization: 'Bearer ' + apiToken } });
      if (!res.ok) {
        console.warn('[Traccar] HTTP error', res.status, 'deviceId:', deviceId);
        return null;
      }
      const data = await res.json();
      if (!data || data.length === 0) {
        console.warn('[Traccar] No position for deviceId:', deviceId);
        return null;
      }
      return data[0];
    }

    function setStatus(chip, textEl, text, isLive) {
      textEl.textContent = text;
      chip.classList.toggle('live', isLive);
    }

    async function updateLine(deviceId, markerRef, chip, textEl, lineLabel, group, lineColor) {
      try {
        const pos = await fetchPosition(deviceId);
        if (pos) {
          const { latitude: lat, longitude: lng, speed } = pos;
          const time = new Date().toLocaleTimeString('hr-HR', { hour: '2-digit', minute: '2-digit' });
          console.log(`[${lineLabel}] deviceId=${deviceId} lat=${lat} lng=${lng} speed=${Math.round(speed ?? 0)} km/h @ ${time}`);
          if (!markerRef.marker) {
            markerRef.marker = L.marker([lat, lng], { icon: busIcon(lineColor) })
              .addTo(group)
              .bindPopup(`🚌 ${lineLabel}`);
          } else {
            markerRef.marker.setLatLng([lat, lng]);
          }
          setStatus(chip, textEl, `${Math.round(speed ?? 0)} km/h · ${time}`, true);
        } else {
          console.warn(`[${lineLabel}] deviceId=${deviceId} — no position`);
          setStatus(chip, textEl, 'Bus kreće u 10:00', false);
        }
      } catch (err) {
        console.error(`[${lineLabel}] deviceId=${deviceId} — error:`, err);
        setStatus(chip, textEl, 'Signal nedostupan', false);
      }
    }

    // Use object wrappers so marker refs stay mutable across calls
    const ref1 = { marker: null };
    const ref2 = { marker: null };

    async function tick() {
      await Promise.all([
        updateLine(deviceId1, ref1, chip1, statusText1, 'Linija 1', line1Group, LINE1_COLOR),
        updateLine(deviceId2, ref2, chip2, statusText2, 'Linija 2', line2Group, LINE2_COLOR),
      ]);
    }

    // ── Time gate — tracking starts at 10:00 ──────────────────────
    const TRACKING_START = new Date('2026-05-27T10:30:00');

    function startTracking() {
      const pending = document.getElementById('tracking-pending');
      if (pending) pending.remove();
      tick();
      setInterval(tick, 10000);
    }

    const now = new Date();
    if (now >= TRACKING_START) {
      startTracking();
    } else {
      const msUntilStart = TRACKING_START - now;

      // Set chips to pre-tracking state
      setStatus(chip1, statusText1, 'Počinje u 10:30', false);
      setStatus(chip2, statusText2, 'Počinje u 10:30', false);

      // Update countdown every second
      function updateCountdown() {
        const remaining = TRACKING_START - new Date();
        if (remaining <= 0) return;
        const hrs  = Math.floor(remaining / 3600000);
        const mins = Math.floor((remaining % 3600000) / 60000);
        const secs = Math.floor((remaining % 60000) / 1000);
        const el = document.getElementById('tracking-pending-countdown');
        if (el) el.textContent = `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      }
      updateCountdown();
      const countdownInterval = setInterval(() => {
        if (new Date() >= TRACKING_START) {
          clearInterval(countdownInterval);
        } else {
          updateCountdown();
        }
      }, 1000);

      setTimeout(startTracking, msUntilStart);
    }

    // ── User location ──────────────────────────────────────────────
    const userLocIcon = L.divIcon({
      html: '<img src="/pois/poi-black.svg" width="32" height="32" alt="" style="display:block;">',
      className: '',
      iconSize: [32, 32],
      iconAnchor: [16, 32],
    });

    let userMarker = null;
    let userLatLng  = null;

    function boundsWithUser(base) {
      return userLatLng ? L.latLngBounds(base).extend(userLatLng) : base;
    }

    function onUserPosition(pos) {
      const { latitude: lat, longitude: lng } = pos.coords;
      userLatLng = [lat, lng];
      if (!userMarker) {
        userMarker = L.marker([lat, lng], { icon: userLocIcon, zIndexOffset: 500 })
          .addTo(map)
          .bindPopup('<div style="font-family:sans-serif;font-size:13px;font-weight:700;color:#0F0B0C;padding:2px 4px">Ovdje ste</div>', { closeButton: false });
        // zoom from user location toward the full route group
        map.fitBounds(boundsWithUser(allBounds), { padding: [20, 20] });
        userMarker.openPopup();
      } else {
        userMarker.setLatLng([lat, lng]);
      }
    }

    if (navigator.geolocation) {
      navigator.geolocation.watchPosition(onUserPosition, null, {
        enableHighAccuracy: true,
        maximumAge: 60000,
      });
    }
  </script>
</BaseLayout>
