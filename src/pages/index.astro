---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import About from '../components/About.astro';
import Info from '../components/Info.astro';
import WhatToExpect from '../components/WhatToExpect.astro';
import Stats from '../components/Stats.astro';
import Transport from '../components/Transport.astro';
import BusSchedule from '../components/BusSchedule.astro';
import CareerTalks from '../components/CareerTalks.astro';
import YourDestiny from '../components/YourDestiny.astro';
import Gallery from '../components/Gallery.astro';
import JobOpportunity from '../components/JobOpportunity.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import Departments from '../components/Departments.astro';
import { config } from '../data/config';
---

<BaseLayout>
	<div class="hero-wrapper">
		<Hero />
	</div>
	{config.showCountdown && <Countdown />}
	{config.showAbout && <About />}
	{config.showInfo && <Info />}
	{config.showWhatToExpect && <WhatToExpect />}
	{config.showStats && <Stats />}
	{config.showTransport && <Transport />}
	{config.showBusSchedule && <BusSchedule />}
	{config.showCareerTalks && <CareerTalks />}
	{config.showYourDestiny && <YourDestiny />}
	{config.showDepartments && <Departments />}
	{config.showGallery && <Gallery />}
	{config.showJobOpportunity && <JobOpportunity />}
	{config.showPartners && <Partners />}
	<Footer />
</BaseLayout>
