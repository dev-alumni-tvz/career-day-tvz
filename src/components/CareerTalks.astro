---
import { talks } from '../data/talks.ts';
const previewTalks = talks.slice(0, 5);
const remaining = talks.length - 5;
---

<section
	class="learn-from-best"
	id="career-talks"
>
	<div class="left-box reveal from-right">
		<h2>Nauči od onih koji <br />znaju... <span>CareerTalks</span></h2>
		<p>
			Uhvati priliku čuti kako izgleda stvaran poslovni svijet - bez filtera. Career Talks razgovori su s ljudima koji su prošli put kojim ti tek krećeš. Postavi pitanje, poslušaj
			savjet i pronađi smjer koji te zbilja zanima.
		</p>
	</div>

	<div class="right-box reveal from-left">
		<div class="schedule-preview">
			<div class="preview-timeline">
				{
					previewTalks.map((talk) => (
						<div class={`preview-talk dept-${talk.department}`}>
							<div class="preview-talk-bar" />
							<div class="preview-talk-info">
								<span class="preview-talk-time">
									{talk.timeStart} – {talk.timeEnd}
								</span>
								<p class="preview-talk-title">{talk.title}</p>
								<span class="preview-talk-company">{talk.company}</span>
							</div>
						</div>
					))
				}
				<p class="preview-more">+ {remaining} više predavanja</p>
			</div>
			<a
				href="/schedule"
				class="preview-cta"
			>
				Pogledaj cijeli raspored
			</a>
		</div>
	</div>
</section>
