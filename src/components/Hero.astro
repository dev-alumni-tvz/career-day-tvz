---
import { Image } from 'astro:assets';
import { config } from '../data/config';
import Nav from '../components/Nav.astro';
import heroImage from '../assets/images/career-2027-hero.svg';
import lumaStar from '../assets/images/lumaStar.svg';

const eventDateLabel = config.eventDate.toLocaleDateString('hr-HR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<section class="header">
	<Nav />

	<div class="hero">
		<h1 class="visually-hidden">
			{config.eventName} — sajam karijera, {eventDateLabel}, {config.venue}
		</h1>

		<Image
			src={heroImage}
			alt={`${config.eventName} — datum i mjesto`}
			class="date-and-place hero-animate"
			loading="eager"
			fetchpriority="high"
		/>

		<a
			href={config.lumaLink}
			target="_blank"
			class="hero-animate"
			style="animation-delay: 0.15s;"
		>
			<button class="cta-pulse">Prijavi se!</button>
		</a>
		<p class="hero-open hero-animate" style="animation-delay: 0.3s;">
			<Image src={lumaStar} alt="star icon" width={15} height={15} class="hero-luma-icon" />
			Otvoreno za <strong>SVE</strong> studente grada Zagreba
		</p>
	</div>

	<div class="scroll-position">
		<div class="scroll-indicator">
			<div class="arrows">
				<svg width="34" height="17" viewBox="0 0 24 12" fill="none">
					<path d="M2 2L12 10L22 2" stroke="#EAC31B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<svg width="34" height="17" viewBox="0 0 24 12" fill="none">
					<path d="M2 2L12 10L22 2" stroke="#EAC31B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</div>
		</div>
	</div>
</section>
