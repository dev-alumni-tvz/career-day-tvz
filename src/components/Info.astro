---
import { Image } from 'astro:assets';
import likImage from '../assets/images/lik2221 1.svg';
import { config } from '../data/config';
---

<section class="info">
	<div class="left-container reveal from-right">
		<h2><span>{config.eventName}</span> je pred vratima!</h2>
		<p>
			Da bi tvoji prvi koraci u svijetu poslovanja bili sigurni i uspješni, ne smiješ propustiti {config.eventName}! Naš događaj okuplja vrhunske poslodavce, stručnjake i studente,
			s ciljem stvaranja prilika za zapošljavanje i razvoj karijere.
		</p>
	</div>
	<div class="right-container reveal from-left">
		<Image
			src={likImage}
			alt="Ilustracija osobe"
		/>
	</div>
</section>
